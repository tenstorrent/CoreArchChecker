build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build --action_env=CC=clang --action_env=CXX=clang++ --host_action_env=CC=clang --host_action_env=CXX=clang++

# clang 20 makes several warnings errors by default: the C99
# implicit-function-declaration, and cast-function-type-mismatch (gflags casts
# its typed validator fn pointers through a generic prototype). -Werror also
# trips on libstdc++'s deprecated std::get_temporary_buffer instantiated from
# gtest's headers. Demote all three for target + host so the external deps
# (cvm, gflags, googletest) build cleanly.
build --copt=-Wno-error=implicit-function-declaration --host_copt=-Wno-error=implicit-function-declaration
build --copt=-Wno-error=deprecated-declarations --host_copt=-Wno-error=deprecated-declarations
build --copt=-Wno-error=cast-function-type-mismatch --host_copt=-Wno-error=cast-function-type-mismatch

# -Wall / -Wextra / -Werror on first-party CoreArchChecker code only (the regex
# excludes external/ repos so cvm and googletest build cleanly).
build --per_file_copt=-external/.*@-Wall,-Wextra,-Werror
